    "breadcrumb.focusForeground": "#FFFFFF",
    "breadcrumb.activeSelectionForeground": "#FF3E81",
    "debugToolBar.background": "#101C30",
    "debugToolBar.border": "#243653",
    "peekView.border": "#7C3AED",
    "peekViewEditor.background": "#0A1427",
    "peekViewResult.background": "#101C30",
    "peekViewTitle.background": "#14233A",
    "merge.currentHeaderBackground": "#213C3C",
    "merge.incomingHeaderBackground": "#271A57",
    "diffEditor.insertedTextBackground": "#192D33",
    "diffEditor.removedTextBackground": "#291B2A",
    "focusBorder": "#7C3AED",
    "foreground": "#E5E7EB",
    "descriptionForeground": "#9CA3AF",
    "icon.foreground": "#AAB6CC",
    "selection.background": "#2F1D64",
    "widget.shadow": "#050A14",
    "statusBarItem.prominentBackground": "#7C3AED",
    "statusBarItem.prominentForeground": "#FFFFFF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8290AA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7C3AED"
      }
    },
    {
      "name": "Constants and language variables",
      "scope": [
        "constant",
        "constant.language",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FF8FB4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A7E8C2"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "number"
      ],
      "settings": {
        "foreground": "#F6C96B"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF3E81"
      }
    },
    {
      "name": "Parameters and variables",
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#E5E7EB"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A5B4FC"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B8C4D9"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F6C96B"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#F6C96B"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#B91C1C"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#C4A7FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7DD3FC",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FF8FB4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff added",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#86EFAC"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF8585"
      }
    }
  ]
}
