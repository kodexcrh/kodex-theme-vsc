    "gitDecoration.modifiedResourceForeground": "#FEC303",
    "gitDecoration.deletedResourceForeground": "#FF6B6B",
    "gitDecoration.untrackedResourceForeground": "#01D4E8",
    "gitDecoration.ignoredResourceForeground": "#66748F",
    "gitDecoration.conflictingResourceForeground": "#FF3E81",
