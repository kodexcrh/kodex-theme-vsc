    "tab.activeBackground": "#080F20",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#0A1427",
    "tab.inactiveForeground": "#9CA3AF",
    "tab.activeBorderTop": "#7C3AED",
    "tab.hoverBackground": "#101C30",
    "tab.unfocusedActiveBorderTop": "#46268D",
    "tab.border": "#0A1427",
    "activityBar.background": "#0A1427",
