    "titleBar.activeBackground": "#0A1427",
    "titleBar.activeForeground": "#E5E7EB",
    "titleBar.inactiveBackground": "#0A1427",
    "titleBar.inactiveForeground": "#8290AA",
    "menu.background": "#101C30",
    "menu.foreground": "#E5E7EB",
    "menu.selectionBackground": "#271A57",
    "menu.selectionForeground": "#FFFFFF",
    "menu.border": "#243653",
    "input.background": "#0A1427",
    "input.foreground": "#E5E7EB",
    "input.border": "#243653",
    "input.placeholderForeground": "#8290AA",
    "inputOption.activeBorder": "#7C3AED",
    "inputOption.activeBackground": "#1F1849",
    "dropdown.background": "#101C30",
    "dropdown.foreground": "#E5E7EB",
    "dropdown.border": "#243653",
    "button.background": "#7C3AED",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#6D28D9",
    "button.secondaryBackground": "#1B2B45",
    "button.secondaryForeground": "#E5E7EB",
    "button.secondaryHoverBackground": "#243653",
    "checkbox.background": "#0A1427",
    "checkbox.foreground": "#E5E7EB",
    "checkbox.border": "#243653",
    "radio.activeForeground": "#FF3E81",
    "badge.background": "#FF3E81",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#FF3E81",
    "notificationCenterHeader.background": "#0A1427",
    "notifications.background": "#101C30",
    "notifications.foreground": "#E5E7EB",
    "notifications.border": "#243653",
    "quickInput.background": "#101C30",
    "quickInput.foreground": "#E5E7EB",
    "quickInputList.focusBackground": "#271A57",
    "panel.background": "#080F20",
    "panel.border": "#243653",
    "panelTitle.activeBorder": "#FF3E81",
    "panelTitle.activeForeground": "#FFFFFF",
    "panelTitle.inactiveForeground": "#9CA3AF",
    "terminal.background": "#080F20",
    "terminal.foreground": "#E5E7EB",
    "terminal.ansiBlack": "#111827",
    "terminal.ansiRed": "#FF6B6B",
    "terminal.ansiGreen": "#86EFAC",
    "terminal.ansiYellow": "#FEC303",
    "terminal.ansiBlue": "#8B9CFF",
    "terminal.ansiMagenta": "#FF3E81",
    "terminal.ansiCyan": "#01D4E8",
    "terminal.ansiWhite": "#E5E7EB",
    "terminal.ansiBrightBlack": "#8290AA",
    "terminal.ansiBrightRed": "#FF8585",
    "terminal.ansiBrightGreen": "#A7F3D0",
    "terminal.ansiBrightYellow": "#FFE07A",
    "terminal.ansiBrightBlue": "#B0BCFF",
    "terminal.ansiBrightMagenta": "#FF78A8",
    "terminal.ansiBrightCyan": "#67E8F9",
    "terminal.ansiBrightWhite": "#FFFFFF",
