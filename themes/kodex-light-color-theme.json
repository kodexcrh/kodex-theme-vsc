    "list.focusOutline": "#7C3AED",
    "list.highlightForeground": "#FF3E81",
    "tree.indentGuidesStroke": "#D8DDED",
    "statusBar.background": "#7C3AED",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.debuggingBackground": "#FF3E81",
