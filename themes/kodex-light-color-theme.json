    "tab.activeBackground": "#F7F8FC",
    "tab.activeForeground": "#202A40",
    "tab.inactiveBackground": "#ECEFF6",
    "tab.inactiveForeground": "#7B8498",
    "tab.activeBorderTop": "#7C3AED",
    "tab.hoverBackground": "#E5E7F2",
    "tab.unfocusedActiveBorderTop": "#7C3AED88",
    "tab.border": "#D8DDED",
    "activityBar.background": "#111D35",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#A9B4CA",
